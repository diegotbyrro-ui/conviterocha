# =============================================================
# ROCHA • SALÃO DO IMÓVEL — VARIÁVEIS DE PRODUÇÃO
# Configure no hPanel da Hostinger. NÃO envie este arquivo com valores reais ao GitHub.
# =============================================================

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Secret Key / service_role do Supabase. SOMENTE no servidor.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_COLE_AQUI_A_CHAVE_SECRETA

# Senha exclusiva do painel administrativo.
# Produção: use 16+ caracteres e não reutilize a senha usada nos testes.
ADMIN_PASSWORD=troque-por-uma-senha-forte-e-exclusiva

# Segredo usado para assinar a sessão do admin. Mínimo: 32 caracteres; recomendado: 64+.
ADMIN_COOKIE_SECRET=troque-por-um-segredo-aleatorio-longo

# Origem pública EXATA do site, sem barra final.
# Exemplo: https://convite.meurocha.com.br
# Em produção, configure para reforçar a proteção contra requisições cross-site.
APP_ORIGIN=https://SEU-DOMINIO.com.br
